{
  "title": "探索 · 血脂 t11：血管里的小船",
  "path": "edu_videos/tansuo/t11_inside_an_artery",
  "lang": "zh",
  "voices": {
    "林": {
      "reference": "edu_videos/tansuo/_shared/cast/lin/voice_zh.wav",
      "reference_text": "我是林。准备好了吗？我们去看看，里面到底是什么。"
    },
    "阿凯": {
      "reference": "edu_videos/tansuo/_shared/cast/kai/voice_zh.wav",
      "reference_text": "我是凯！等等——我们要钻进去？"
    }
  },
  "source_sha256": "57daf82015d9cabc7cb60e4838b22319663456bb6303910be28e71a7493f60e0",
  "notes": [
    {
      "title": "分镜草稿",
      "items": [
        "逐镜叙事节奏估算，非实测配音；讲稿审查及整集音频听审后校准，不能直接用于收费视频提交。"
      ]
    }
  ],
  "scenes": [
    {
      "id": "s1",
      "title": "医院走廊 · 长椅与模型桌",
      "subtitle": "日内；正常尺度",
      "shots": [
        {
          "id": "V01",
          "title": "两张纸",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P01.png",
          "lines": [
            {
              "speaker": "阿凯",
              "text": "我爸五十二岁，刚放了支架。我的体检单上，也有个箭头。"
            }
          ]
        },
        {
          "id": "V02",
          "title": "凯的问题",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P01.png",
          "lines": [
            {
              "speaker": "阿凯",
              "text": "我才二十八，又瘦。这个“坏胆固醇”偏高，要紧吗？"
            }
          ]
        },
        {
          "id": "V03",
          "title": "探索表启动",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P02_v3.png",
          "lines": [
            {
              "speaker": "林",
              "text": "先去看看。化验单上的这个数，量的到底是什么。"
            }
          ]
        }
      ]
    },
    {
      "id": "s2",
      "title": "冠状动脉腔内 · 从细胞尺度进入纳米尺度",
      "subtitle": "连续；微米→纳米，缩放明确显示",
      "shots": [
        {
          "id": "V04",
          "title": "红细胞擦过",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P03.png",
          "lines": [
            {
              "speaker": "阿凯",
              "text": "这么挤？"
            },
            {
              "speaker": "林",
              "text": "这些软软的圆盘，是红细胞。"
            }
          ]
        },
        {
          "id": "V05",
          "title": "再缩小一级",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P03.png",
          "lines": [
            {
              "speaker": "林",
              "text": "LDL 还要小几百倍。得再缩小，才能看清。"
            }
          ]
        },
        {
          "id": "V06",
          "title": "油怎样在血里运",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P04.png",
          "lines": [
            {
              "speaker": "阿凯",
              "text": "血脂，就是血里漂着油？"
            },
            {
              "speaker": "林",
              "text": "油不好溶在水里，得装进脂蛋白这些“小船”里运。"
            }
          ]
        },
        {
          "id": "V07",
          "title": "颗粒家族",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P04.png",
          "lines": [
            {
              "speaker": "林",
              "text": "有乳糜微粒、VLDL、LDL，还有 HDL。这一回，我们跟着 LDL。"
            }
          ]
        }
      ]
    },
    {
      "id": "s3",
      "title": "单颗 LDL 观察区",
      "subtitle": "连续；纳米尺度",
      "shots": [
        {
          "id": "V08",
          "title": "船和货物",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P05.png",
          "lines": [
            {
              "speaker": "林",
              "text": "LDL 是颗粒，胆固醇是它运的货。它们不是同一个东西。"
            }
          ]
        },
        {
          "id": "V09",
          "title": "一条蛋白",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P05.png",
          "lines": [
            {
              "speaker": "林",
              "text": "外面这条蛋白叫 ApoB。每颗 LDL 上有一条。"
            }
          ]
        },
        {
          "id": "V10",
          "title": "化验单量的是货物",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V10.png",
          "lines": [
            {
              "speaker": "林",
              "text": "LDL-C 测的是血里 LDL 携带的胆固醇有多少，不是直接数有几颗 LDL。"
            }
          ]
        },
        {
          "id": "V11",
          "title": "有用，也有风险",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V11.png",
          "lines": [
            {
              "speaker": "阿凯",
              "text": "那它到底是好是坏？"
            },
            {
              "speaker": "林",
              "text": "胆固醇有用。但 LDL 过多、暴露太久，动脉粥样硬化的风险会升高。"
            }
          ]
        }
      ]
    },
    {
      "id": "s4",
      "title": "动脉内皮及内皮下空间",
      "subtitle": "连续；细胞尺度定位→纳米特写",
      "shots": [
        {
          "id": "V12",
          "title": "墙没有先破",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V12.png",
          "lines": [
            {
              "speaker": "阿凯",
              "text": "我爸的血管，是这里出了问题？"
            },
            {
              "speaker": "林",
              "text": "先看这层内皮。它不需要先破。"
            }
          ]
        },
        {
          "id": "V13",
          "title": "一颗穿过内皮",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V13.png",
          "lines": [
            {
              "speaker": "林",
              "text": "LDL 可以被内皮细胞运过去。这是一种进入血管壁的途径。"
            }
          ]
        },
        {
          "id": "V14",
          "title": "进入不等于留下",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V14.png",
          "lines": [
            {
              "speaker": "林",
              "text": "进入以后，有的能离开，有的会留下。"
            }
          ]
        },
        {
          "id": "V15",
          "title": "被粘住",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P08.png",
          "lines": [
            {
              "speaker": "阿凯",
              "text": "留下的，是卡在哪儿了？"
            },
            {
              "speaker": "林",
              "text": "血管壁里的蛋白聚糖，能把一些颗粒粘住。"
            }
          ]
        }
      ]
    },
    {
      "id": "s5",
      "title": "同一段动脉壁 · 时间推移",
      "subtitle": "时间压缩示意；不同人的进展并不相同",
      "shots": [
        {
          "id": "V16",
          "title": "免疫细胞来吞",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P09.png",
          "lines": [
            {
              "speaker": "林",
              "text": "留下的颗粒可能发生变化。免疫细胞来吞，脂质也会在细胞里越积越多。"
            }
          ]
        },
        {
          "id": "V17",
          "title": "泡沫细胞",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P09.png",
          "lines": [
            {
              "speaker": "林",
              "text": "这叫泡沫细胞。长期的炎症和细胞变化，会参与斑块形成。"
            }
          ]
        },
        {
          "id": "V18",
          "title": "斑块在壁里",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P09.png",
          "lines": [
            {
              "speaker": "林",
              "text": "时间久了，壁里可能形成脂质核心，表面盖着纤维帽。斑块长在血管壁里。"
            }
          ]
        },
        {
          "id": "V19",
          "title": "破裂与血栓",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P10.png",
          "lines": [
            {
              "speaker": "阿凯",
              "text": "我爸那次，是这样？"
            },
            {
              "speaker": "林",
              "text": "这是其中一种机制：帽子裂开，血栓可能在这里形成，堵住血管。"
            }
          ]
        },
        {
          "id": "V20",
          "title": "从惊讶回到问题",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P10.png",
          "lines": [
            {
              "speaker": "林",
              "text": "但不是只能等它发生。前面这条过程，有机会提前干预。"
            }
          ]
        }
      ]
    },
    {
      "id": "s6",
      "title": "累积暴露比较区 · 概念空间",
      "subtitle": "概念图，无物理比例尺",
      "shots": [
        {
          "id": "V21",
          "title": "量和时间",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P11.png",
          "lines": [
            {
              "speaker": "阿凯",
              "text": "那我才二十八，还早吧？"
            },
            {
              "speaker": "林",
              "text": "不只看现在的数，也要看这样的水平持续了多久。"
            }
          ]
        },
        {
          "id": "V22",
          "title": "遗传研究说明什么",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V22.png",
          "lines": [
            {
              "speaker": "林",
              "text": "一项研究跟踪了十五年。某些基因变异让人从小 LDL 就低一些，这些人的冠心病风险也明显较低。"
            }
          ]
        }
      ]
    },
    {
      "id": "s7",
      "title": "肝脏及肝细胞观察区",
      "subtitle": "从动脉示意转肝脏定位；细胞尺度",
      "shots": [
        {
          "id": "V23",
          "title": "父亲的他汀",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V23.png",
          "lines": [
            {
              "speaker": "阿凯",
              "text": "那我爸用的他汀，只是把化验单上的数字压低吗？"
            }
          ]
        },
        {
          "id": "V24",
          "title": "合成减少",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V24.png",
          "lines": [
            {
              "speaker": "林",
              "text": "它会抑制胆固醇合成中的一个酶，让肝细胞少造胆固醇。"
            }
          ]
        },
        {
          "id": "V25",
          "title": "受体增多",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V25.png",
          "lines": [
            {
              "speaker": "林",
              "text": "随后，细胞表面的 LDL 受体增多，就能收回更多 LDL。"
            }
          ]
        },
        {
          "id": "V26",
          "title": "颗粒被收回",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V26.png",
          "lines": [
            {
              "speaker": "林",
              "text": "LDL 被结合、吞进细胞，血里循环的颗粒就少了。"
            }
          ]
        },
        {
          "id": "V27",
          "title": "治标还是治本",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V27.png",
          "lines": [
            {
              "speaker": "阿凯",
              "text": "所以，不只是数字好看？"
            },
            {
              "speaker": "林",
              "text": "对，它减少了能进入血管壁的颗粒。但不会把遗传等升高原因都消除。"
            }
          ]
        }
      ]
    },
    {
      "id": "s8",
      "title": "结局证据与风险比较区 · 概念空间",
      "subtitle": "概念图，无物理比例尺",
      "shots": [
        {
          "id": "V28",
          "title": "血脂不只有LDL",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V28.png",
          "lines": [
            {
              "speaker": "阿凯",
              "text": "是把所有血脂都清掉吗？"
            },
            {
              "speaker": "林",
              "text": "不是。血脂包括胆固醇、甘油三酯。他汀主要降低 LDL 胆固醇。"
            }
          ]
        },
        {
          "id": "V29",
          "title": "试验看的是事件",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V29.png",
          "lines": [
            {
              "speaker": "阿凯",
              "text": "那心梗也会少吗？"
            },
            {
              "speaker": "林",
              "text": "他汀试验，以及一些其他降 LDL 治疗的试验，确实观察到心血管事件减少。"
            }
          ]
        },
        {
          "id": "V30",
          "title": "先说明是假设",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V30.png",
          "lines": [
            {
              "speaker": "林",
              "text": "看一个假设例子，只用来算清楚获益，不是预测你会怎样。"
            }
          ]
        },
        {
          "id": "V31",
          "title": "同一人群内比较",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V31.png",
          "lines": [
            {
              "speaker": "林",
              "text": "原来一百人里有十人发生事件，减少两成，就变成八人，少两人。"
            }
          ]
        },
        {
          "id": "V32",
          "title": "基线风险改变获益",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V32.png",
          "lines": [
            {
              "speaker": "林",
              "text": "如果原来是二十人，同样减少两成，就变成十六人，少四人。"
            }
          ]
        },
        {
          "id": "V33",
          "title": "还有其他风险",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V33.png",
          "lines": [
            {
              "speaker": "林",
              "text": "真实获益要看具体情况。降 LDL 也不等于血管恢复全新，血压、吸烟、糖尿病等风险还要另看。"
            }
          ]
        }
      ]
    },
    {
      "id": "s9",
      "title": "医院走廊 · 回到两张单据",
      "subtitle": "日内；恢复正常尺度",
      "shots": [
        {
          "id": "V34",
          "title": "回到那个箭头",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P12.png",
          "lines": [
            {
              "speaker": "阿凯",
              "text": "所以，这个箭头不能单独说明我该怎么办？"
            },
            {
              "speaker": "林",
              "text": "对。化验单的参考范围，不等于每个人的治疗目标。"
            }
          ]
        },
        {
          "id": "V35",
          "title": "整体风险",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P12.png",
          "lines": [
            {
              "speaker": "林",
              "text": "你和父亲的情况不同。年龄、家族史、有没有心血管病，都要一起看；用药还要权衡获益和风险。"
            }
          ]
        },
        {
          "id": "V36",
          "title": "凯带走的理解",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/P13.png",
          "lines": [
            {
              "speaker": "阿凯",
              "text": "LDL 是运货的颗粒。太多、太久，风险会升高。我得带着这两张单子，再问清楚。"
            }
          ]
        },
        {
          "id": "V37",
          "title": "下期问题",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V37.png",
          "lines": [
            {
              "speaker": "阿凯",
              "text": "可我不胖，为什么也会高？"
            },
            {
              "speaker": "林",
              "text": "下一期，我们接着看身体怎么调节它。"
            }
          ]
        },
        {
          "id": "V38",
          "title": "片尾说明与出处",
          "image": "edu_videos/tansuo/t11_inside_an_artery/storyboard/diagrams/V38.png",
          "lines": []
        }
      ]
    }
  ]
}