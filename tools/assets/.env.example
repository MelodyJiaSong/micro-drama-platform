# Copy to the repo root as `.env` (gitignored) and fill in.
# Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create API Token
# (Object Read & Write, scoped to this one bucket).
# R2_ENDPOINT is the "endpoint for S3 clients" value the dashboard shows.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
