    },
    {
      "id": "cutaway",
      "zh": "切出镜头",
      "en": "Cutaway",
      "zh_alt": "",
      "category": "shottype",
      "module": "影视改编",
      "def_zh": "短暂离开主体动作的镜头，可以去别的地点、时间甚至想象，通常再切回来。",
      "def_en": "A shot that briefly leaves the main action — to another place, time or even an imagined image — and usually cuts back.",
      "where": "1.2.5 镜头",
      "notes": [
        "有资料把插入镜头算作切出的一种。",
        "中文的「空镜」（无人、以景物为主的镜头）不等于 cutaway。"
      ],
      "sources": [
        "https://studiobinder.com/blog/cutaway-shot"
      ],
      "in_graph": false,
      "x": 0,
      "y": 0
    },
    {
      "id": "longtake",
      "zh": "长镜头",
      "en": "Long take / oner",
      "zh_alt": "一镜到底",
      "category": "shottype",
      "module": "影视改编",
      "def_zh": "时长明显超出正常剪辑节奏的单个镜头；拍完一整段的叫段落镜头，整部片看起来不切的叫一镜到底。",
      "def_en": "A single shot that runs well beyond normal editing rhythm; one covering a whole sequence is a plan-séquence, and a film made to look uncut is a one-shot film.",
      "where": "1.2.5.6 运镜、1.2.4 覆盖",
      "notes": [
        "「长」没有绝对标准；长镜头说单个镜头，一镜到底说整段看起来不切。",
        "AI 单镜生成时长有限，长镜头要按拍点拆开。"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/Long_take",
        "https://zh.wikipedia.org/wiki/长镜头"
      ],
      "in_graph": false,
      "x": 0,
      "y": 0
    },
    {
      "id": "punchin",
      "zh": "推近",
      "en": "Punch-in",
      "zh_alt": "数码推近、裁切推近",
      "category": "shottype",
      "module": "剪辑",
      "def_zh": "剪辑时把已有画面放大裁切，做出更近的景别，用来强调、调节奏或模拟多机位。",
      "def_en": "In editing, enlarging and cropping existing footage to make a tighter framing — for emphasis, rhythm, or to simulate multiple cameras.",
      "where": "后期剪辑",
      "notes": [
        "和另外实拍的切入近景（cut-in）不同；音频里的 punch-in 是补录，意思完全不同。",
        "中文译名未找到权威辞典核实。"
      ],
      "sources": [
        "https://howtofilmschool.com/dictionary/punch-in/"
      ],
      "in_graph": false,
      "x": 0,
      "y": 0
    },
    {
      "id": "inciting",
      "zh": "激励事件",
      "en": "Inciting incident",
      "zh_alt": "催化剂（Save the Cat）",
      "category": "narrative",
      "module": "故事创作",
      "def_zh": "彻底打破主角生活平衡、逼他必须回应的事件，出现在前四分之一；开启「这个故事」。",
