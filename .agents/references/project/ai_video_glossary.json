    {
      "id": "sequence",
      "zh": "段落",
      "en": "Sequence",
      "zh_alt": "序列（McKee《故事》中译本）",
      "category": "narrative",
      "module": "故事创作",
      "def_zh": "由一场或几场组成、有自己起承转合的叙事单元，推向一个小高潮或转折。本剧按「英雄目标段落」用：主角追一个具体可见的短期目标，直到新消息改变目标。",
      "def_en": "A self-contained narrative unit of one or more scenes that builds to a minor climax or turn. We use Eric Edson's hero goal sequence: the hero pursues one concrete short-term goal until news changes it.",
      "where": "1.1.2.1 电影「推进单位」；EP1 的冷开场、报到、狗头人……",
      "notes": [
        "段落是否必须时空统一，各家说法不一：维基强调通常有地点或时间统一，Final Draft 的例子则跨多个地点。",
        "长场里也可能出现段落边界（EP1 葡萄园：第三、四段同一场）。",
        "不要和「段落镜头」（一个长镜头拍完一整段）混淆。"
      ],
      "sources": [
        "https://en.wikipedia.org/wiki/Sequence_(filmmaking)",
        "https://www.finaldraft.com/blog/what-is-the-difference-between-a-scene-and-a-sequence",
        "https://filmcourage.com/2017/07/27/new-paradigm-screenplay-structure-csun-professor-eric-edson/"
      ],
      "in_graph": true,
      "x": 300,
      "y": 360
    },
