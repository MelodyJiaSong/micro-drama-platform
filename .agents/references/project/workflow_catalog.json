{
  "schema_version": 2,
  "groups": [
    {
      "id": "overview",
      "title": "总览",
      "description": "高于单个模块的全局视图：工作流全景、术语表与决策记录规范。",
      "number": "1.0",
      "category": "ai-video",
      "overview": true
    },
    {
      "id": "story",
      "title": "故事创作",
      "description": "",
      "number": "1.1",
      "category": "ai-video"
    },
    {
      "id": "filming",
      "title": "影视改编",
      "description": "影视改编模块指南，按拍摄单位从大到小：片种（电影的幕、连续剧的集）→ 场 → 覆盖 → 镜头。",
      "number": "1.2",
      "category": "ai-video"
    },
    {
      "id": "prompts",
      "title": "Prompt 编译与出片",
      "description": "Prompt 编译（结构、固定规则、Seedance 写法）、每镜参考（overhead、复杂镜 previz、人物与场景图、声样），以及出片（资料包、提交、记日志、落盘）。",
      "number": "1.3",
      "category": "ai-video"
    },
    {
      "id": "edit",
      "title": "剪辑",
      "description": "剪辑模块（设计稿）：选条、粗剪、精剪、锁片，AI 素材的修补与遮掩，以及 AI 剪辑工具现状。",
      "number": "1.4",
      "category": "ai-video"
    },
    {
      "id": "sound",
      "title": "声音与音乐",
      "description": "对白、环境声与音效、音乐、混音（待设计）。",
      "number": "1.5",
      "category": "ai-video"
    },
    {
      "id": "delivery",
      "title": "成片交付",
      "description": "调色、字幕、AI 标识、质检与母版（待设计）。",
      "number": "1.6",
      "category": "ai-video"
    },
    {
      "id": "production",
      "title": "制作、服务与资源",
      "description": "按任务适用的制作规范（如人物资产补齐）、收费服务规则、调研与共享资产规则；资产实体仍在共享资产库。",
      "number": "1.7",
      "category": "ai-video"
    },
    {
      "id": "agents",
      "title": "代理与执行设置",
      "description": "Claude 与 Codex 的共用入口、AI Video 编排入口与工作流目录、配置声明和执行约定。运行环境可覆盖这些声明，不能据此认定某次 run 的有效权限或模型。",
      "number": "2.1",
      "category": "agents"
    },
    {
      "id": "app",
      "title": "管理应用",
      "description": "管理应用里实现三模块、编译、资产与服务调用的代码和静态默认值；只读展示源码声明，不执行。",
      "number": "2.2",
      "category": "agents"
    },
    {
      "id": "tools",
      "title": "制作工具",
      "description": "tools/ 下的制作脚本与配置：生成、预演、资料包与出片、资产同步等；按任务调用，登记不表示自动运行。",
      "number": "2.3",
      "category": "agents"
    }
  ],
