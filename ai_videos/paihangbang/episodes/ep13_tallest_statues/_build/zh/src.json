 "insights": [
  {
   "i": 0,
   "text": "The Statue of Liberty is 46 m from base to torch: too short to make this list."
  },
  {
   "i": 1,
   "text": "China now curbs statues over 30 m. Jingzhou took down its 58 m Guan Yu in 2021-22."
  },
  {
   "i": 2,
   "text": "Japan has 9 statues on this list, but the newest of them went up back in 1994."
  },
  {
   "i": 3,
   "text": "4 statues here were unveiled since 2022: in India, Thailand, the Philippines, Indonesia."
  },
  {
   "i": 4,
   "text": "Spring Temple Buddha is often listed at 128 m. That includes its 20 m lotus throne."
  },
  {
   "i": 5,
   "text": "Next: the Statue of Unity, 66 m taller than any other statue on Earth."
  }
 ]
}