 "insights": [
  {
   "i": 0,
   "text": "SEASONAL = it flows only part of the year, fed by snowmelt or rainy-season runoff."
  },
  {
   "i": 1,
   "text": "Zimbabwe's Mutarazi is often listed at 762 m; World Waterfall Database estimates ~479 m."
  },
  {
   "i": 2,
   "text": "Norway's Mongefossen (773 m) would rank here, but hydropower has kept it dry since 1977."
  },
  {
   "i": 3,
   "text": "Next: a Swiss fall that grew 90 m in 2020, when canyoneers abseiled down and measured it."
  },
  {
   "i": 4,
   "text": "Angel's 979 m adds rapids below its 807 m drop. Drop those and Tugela (948 m) wins."
  }
 ]
