 "insights": [
  {
   "i": 0,
   "text": "Old lists: Poso 450 m, Wakatipu 420 m. Surveys show 395 m and ~380 m, so both are out."
  },
  {
   "i": 1,
   "text": "Next: Sarez Lake, born in 1911 when a quake-triggered landslide dammed a Pamir river."
  },
  {
   "i": 2,
   "text": "Three of the top 10 are Patagonian lakes, carved by glaciers that are still retreating."
  },
  {
   "i": 3,
   "text": "Next: Viedma. A 2022 survey reported 900 m (unpublished); peer-reviewed sonar: ~750 m."
  },
  {
   "i": 4,
   "text": "Next, No. 1: a lake holding about 20% of the world's unfrozen fresh water (UNESCO)."
  }
 ]
