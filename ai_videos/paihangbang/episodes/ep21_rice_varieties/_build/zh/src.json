 "insights": [
  {
   "i": 0,
   "text": "IRRI's genebank in the Philippines stores over 127,000 rice samples, the largest on Earth."
  },
  {
   "i": 1,
   "text": "Glutinous rice is gluten-free: 'glutinous' means glue-like sticky, not gluten."
  },
  {
   "i": 2,
   "text": "Sticky or fluffy? It's the starch: low-amylose rice clings, high-amylose rice stays apart."
  },
  {
   "i": 3,
   "text": "Rice is the staple food for nearly half of the world's people."
  },
  {
   "i": 4,
   "text": "Senegal's ceebu jën, UNESCO-listed in 2021, is made with fish and broken rice."
  },
  {
   "i": 5,
   "text": "2004 World Food Prize: Yuan Longping (hybrid rice) and Monty Jones (NERICA, for Africa)."
  }
 ]
