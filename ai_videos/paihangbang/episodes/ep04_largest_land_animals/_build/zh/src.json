  {
   "i": 0,
   "text": "Each flag marks the country where most of that species lives in the wild."
  },
  {
   "i": 1,
   "text": "Just missed the cut at #31: the Galápagos giant tortoise, at about 295 kg."
  },
  {
   "i": 2,
   "text": "Saltwater crocodiles (males ~460 kg) would rank here, but we count crocodiles as aquatic."
  },
  {
   "i": 3,
   "text": "The kouprey (~750 kg) would rank near here, but none has been confirmed alive in decades."
  },
  {
   "i": 4,
   "text": "From here on, every typical adult male weighs a tonne or more."
  },
  {
   "i": 5,
   "text": "Giraffe experts now recognise 4 species; the IUCN Red List still lists just one."
  }
 ]
