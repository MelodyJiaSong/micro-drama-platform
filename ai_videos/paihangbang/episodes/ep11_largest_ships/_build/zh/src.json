 "insights": [
  {
   "i": 0,
   "text": "No oil tanker makes this list: the biggest still trading is 170,618 GT, just below No. 42."
  },
  {
   "i": 1,
   "text": "7 of these 42 ship classes did not exist before 2025. The race to build bigger isn't over."
  },
  {
   "i": 2,
   "text": "Gross tonnage measures a ship's enclosed volume, not its weight. Cruise ships score high."
  },
  {
   "i": 3,
   "text": "Next: the class of Ever Given, the ship that blocked the Suez Canal for six days in 2021."
  },
  {
   "i": 4,
   "text": "MSC Irina carries the most boxes (24,346 TEU), yet 3 container classes outrank it."
  },
  {
   "i": 5,
   "text": "No. 1 is 62% bigger than Icon of the Seas, and it's neither a cargo nor a cruise ship."
  }
 ]
}