 "insights": [
  {
   "i": 0,
   "text": "How to read: est. = modelled estimate, no tag = counted deaths. Years differ per card."
  },
  {
   "i": 1,
   "text": "Rare viruses are barely tracked: several counts here cover only one country."
  },
  {
   "i": 2,
   "text": "Ebola, SARS, MERS and Marburg together killed fewer than 18,000 people."
  },
  {
   "i": 3,
   "text": "Rabies is almost always fatal once symptoms start, yet a vaccine has existed since 1885."
  },
  {
   "i": 4,
   "text": "COVID-19's reported toll is 7.1M. Excess-death studies put it at 15–28M."
  },
  {
   "i": 5,
   "text": "Measles and HIV are neck and neck, and measles is only counted from 1980."
  },
  {
   "i": 6,
   "text": "Smallpox is the only human disease ever eradicated. Its last natural case was in 1977."
  }
 ]
}