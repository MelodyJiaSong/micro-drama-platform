  "windows": [
    {
      "start": 3.88,
      "end": 5.08,
      "text": "Hold on a second, son.",
      "source_dbfs": -26.8,
      "ambience_dbfs": -39.8,
      "margin_db": 13.0
    },
    {
      "start": 5.62,
      "end": 6.94,
      "text": "What brings you up here this early?",
      "source_dbfs": -25.4,
      "ambience_dbfs": -39.4,
      "margin_db": 14.0
    },
    {
      "start": 7.64,
      "end": 8.7,
      "text": "I'm going to the abbey.",
      "source_dbfs": -26.8,
      "ambience_dbfs": -39.7,
      "margin_db": 12.9
    },
    {
      "start": 9.42,
      "end": 10.74,
      "text": "Brother Sammuel sent for me.",
      "source_dbfs": -28.5,
      "ambience_dbfs": -39.9,
      "margin_db": 11.4
    },
    {
      "start": 11.56,
      "end": 12.16,
      "text": "Here's his letter.",
      "source_dbfs": -26.7,
      "ambience_dbfs": -39.7,
      "margin_db": 13.0
    },
    {
      "start": 14.92,
      "end": 16.94,
      "text": "Yep, that's the abbey's seal, all right.",
      "source_dbfs": -26.3,
      "ambience_dbfs": -39.8,
      "margin_db": 13.5
    },
    {
      "start": 17.46,
      "end": 19.4,
      "text": "Go on through. And stick to the road.",
      "source_dbfs": -26.1,
      "ambience_dbfs": -39.3,
      "margin_db": 13.2
    },
    {
      "start": 19.76,
      "end": 21.04,
      "text": "It's not safe off it these days.",
      "source_dbfs": -26.1,
      "ambience_dbfs": -38.8,
      "margin_db": 12.7
    },
    {
      "start": 43.625,
      "end": 46.785,
      "text": "Hey! You! Help me!",
      "source_dbfs": -26.5,
      "ambience_dbfs": -38.3,
      "margin_db": 11.8
    },
    {
      "start": 51.605,
      "end": 53.565,
      "text": "You're bleeding. Here, lean on me.",
      "source_dbfs": -26.9,
      "ambience_dbfs": -38.0,
      "margin_db": 11.1
    },
    {
      "start": 54.705,
      "end": 55.725,
      "text": "Get me to the abbey.",
      "source_dbfs": -26.7,
      "ambience_dbfs": -37.4,
      "margin_db": 10.7
    },
    {
      "start": 56.345,
      "end": 57.585,
      "text": "Brother Sammuel can stop the bleeding.",
      "source_dbfs": -26.0,
      "ambience_dbfs": -37.4,
      "margin_db": 11.4
    },
    {
      "start": 58.205,
      "end": 59.645,
      "text": "And there's a woman trapped in the vineyard.",
      "source_dbfs": -25.3,
      "ambience_dbfs": -38.0,
      "margin_db": 12.7
    },
    {
      "start": 60.085,
      "end": 60.325,
      "text": "Hurry.",
      "source_dbfs": -23.8,
      "ambience_dbfs": -39.5,
      "margin_db": 15.7
    },
    {
      "start": 61.005,
      "end": 61.865,
      "text": "I'm going to the abbey too.",
      "source_dbfs": -25.4,
      "ambience_dbfs": -37.5,
      "margin_db": 12.1
    },
    {
      "start": 62.125,
      "end": 62.385,
      "text": "Come on.",
      "source_dbfs": -25.0,
      "ambience_dbfs": -38.1,
      "margin_db": 13.1
    },
    {
      "start": 72.875,
      "end": 74.995,
      "text": "Brother! This man is hurt.",
      "source_dbfs": -28.6,
      "ambience_dbfs": -51.2,
      "margin_db": 22.6
    },
    {
      "start": 75.175,
      "end": 75.875,
      "text": "Where is Brother Sammuel?",
      "source_dbfs": -24.8,
      "ambience_dbfs": -49.0,
      "margin_db": 24.2
    },
    {
      "start": 77.615,
      "end": 78.795,
      "text": "In the Hall of Arms.",
      "source_dbfs": -26.6,
      "ambience_dbfs": -49.8,
      "margin_db": 23.2
    },
    {
      "start": 79.315,
      "end": 80.775,
      "text": "That way, through the side door.",
      "source_dbfs": -26.5,
      "ambience_dbfs": -47.7,
      "margin_db": 21.2
    },
    {
      "start": 81.035,
      "end": 81.635,
      "text": "I'll come with you.",
      "source_dbfs": -26.0,
      "ambience_dbfs": -47.5,
      "margin_db": 21.5
    }
  ],
